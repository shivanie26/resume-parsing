{
  "name": "smart-resume-recruitment-platform",
  "version": "1.0.0",
  "description": "Smart Resume Parsing and Competency Assessment Platform with Bias-Aware Recruitment",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "resume-parser",
    "recruitment",
    "nlp",
    "bias-aware",
    "competency-assessment"
  ],
