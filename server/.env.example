# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URL
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
# Make sure to URL-encode special characters in password (e.g., @ as %40)
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/smart_resume_db?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_random_key_replace_this_with_a_secure_token

# Node Environment
NODE_ENV=production

# Admin Notification Email (for contact inquiries)
ADMIN_EMAIL=eshivani26@gmail.com

# (Optional) Automated Gmail SMTP delivery credentials
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_google_app_password
